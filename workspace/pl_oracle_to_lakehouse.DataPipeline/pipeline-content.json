{
  "properties": {
    "parameters": {
      "oracle_schema": { "type": "string", "defaultValue": "SALES" },
      "oracle_table": { "type": "string", "defaultValue": "CUSTOMERS" },
      "lakehouse_table": { "type": "string", "defaultValue": "customers" }
    },
    "activities": [
      {
        "name": "Copy Oracle to Lakehouse",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "OracleSource",
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "datasetSettings": {
              "annotations": [],
              "type": "OracleTable",
              "schema": [],
              "typeProperties": {
                "schema": { "value": "@pipeline().parameters.oracle_schema", "type": "Expression" },
                "table": { "value": "@pipeline().parameters.oracle_table", "type": "Expression" }
              },
              "externalReferences": {
                "connection": "aaaaaaaa-0000-0000-0000-000000000004"
              }
            }
          },
          "sink": {
            "type": "LakehouseTableSink",
            "tableActionOption": "Overwrite",
            "datasetSettings": {
              "annotations": [],
              "linkedService": {
                "name": "lh_bronze",
                "properties": {
                  "annotations": [],
                  "type": "Lakehouse",
                  "typeProperties": {
                    "workspaceId": "aaaaaaaa-0000-0000-0000-000000000001",
                    "artifactId": "aaaaaaaa-0000-0000-0000-000000000002",
                    "rootFolder": "Tables"
                  }
                }
              },
              "type": "LakehouseTable",
              "schema": [],
              "typeProperties": {
                "table": { "value": "@pipeline().parameters.lakehouse_table", "type": "Expression" }
              }
            }
          },
          "enableStaging": false
        }
      }
    ]
  }
}
